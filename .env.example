# Server-side only. Copy to .env.local and fill in locally; never commit secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant account ID of the sandbox business account associated with the app.
PAYPAL_MERCHANT_ID=
AEGIRON_APP_ORIGIN=http://127.0.0.1:3000
# Optional absolute directory on a persistent local/server disk.
# AEGIRON_DATA_DIR=

# Hosted storage: use a pooled PostgreSQL URL with TLS from Neon/Vercel.
# DATABASE_URL=
# Required on Vercel; at least 16 characters. Share privately with invited judges.
# AEGIRON_DEMO_ACCESS_CODE=
